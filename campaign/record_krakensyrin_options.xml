      <genericcontrol name="ctrl">
        <bounds rect="0,0,1,1" />
        <script>
CATS = { "weapons", "damage", "crits", "spells", "magic", "class", "status", "heal", "init" }

function getEnabled(catId)
  if CCSyrin and CCSyrin.isCategoryEnabled then return CCSyrin.isCategoryEnabled(catId) end
  return true
end

function setEnabled(catId, val)
  if CCSyrin and CCSyrin.setCategoryEnabled then CCSyrin.setCategoryEnabled(catId, val) end
end

function refreshAll()
  local n = 0
  for _, c in ipairs(CATS) do
    local on = getEnabled(c)
    if on then n = n + 1 end
    local ctrl = window["state_" .. c]
    if ctrl then ctrl.setValue(on and "On" or "Off") end
  end
  window.summary.setValue("Enabled categories: " .. n .. " / " .. #CATS)
end

function toggle(catId)
  setEnabled(catId, not getEnabled(catId))
  refreshAll()
end

function setAll(val)
  for _, c in ipairs(CATS) do setEnabled(c, val) end
  refreshAll()
end

function onInit()
  refreshAll()
end
        </script>
      </genericcontrol>

